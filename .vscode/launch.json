{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (Windows GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/a.out",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
          {
              "description": "Enable pretty-printing for gdb",
              "text": "-enable-pretty-printing",
              "ignoreFailures": true
          },
          {
              "description": "Set Disassembly Flavor to Intel",
              "text": "-gdb-set disassembly-flavor intel",
              "ignoreFailures": true
          }
      ]
    },
    {
      "name": "Debug (Termux GDB)",
      "type": "gdb",
      "request": "launch",
      "target": "/data/data/com.termux/files/home/Programmazione/a.out",
      "cwd": "/data/data/com.termux/files/home/Programmazione",
      "gdbpath": "/data/data/com.termux/files/usr/bin/gdb",
      "valuesFormatting": "parseText"
    }
  ]
}